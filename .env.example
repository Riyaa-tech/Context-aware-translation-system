# Copy to .env (never commit .env). All values are optional.
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
# Pinned commit for reproducibility; change only deliberately and record it.
NLLB_MODEL_REVISION=f8d333a098d19b4fd9a8b18f94170487ad3f821d
NLLB_DEVICE=auto          # auto | cpu | cuda
NLLB_BATCH_SIZE=8
NLLB_PRELOAD=0            # 1 = load the model at server start
ALLOW_PLANNED_DIRECTIONS=0  # 1 = allow the 6 untested directions from the paper
